// Wrangler config used only by the test suite (vitest.config.ts). Committed
// on purpose, unlike wrangler.jsonc — these are fake, test-only values, not
// a real account's deployment config.
{
  "name": "cloudflare-gauth-proxy-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_DISCOVERY_CACHE",
      "id": "test-kv-namespace"
    }
  ],
  "vars": {
    "SELF_ORIGIN": "http://example.com"
  }
}
